# Uploaded files (served at /storage/…): pictures only — nothing in here can ever run as a script.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|phar|inc|php[0-9]|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
